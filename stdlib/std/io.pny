/**
 * std.io - Pony++ 输入输出标准库
 *
 * API:
 *   print(x)            - 打印到标准输出
 *   println(x)          - 打印换行
 *   read()              - 读取一行输入
 *   file_open(path, mode) - 打开文件
 *   file_close(f)       - 关闭文件
 *   file_read(f)        - 读取文件内容
 *   file_write(f, data) - 写入文件
 *   stdout(str)         - 写入标准输出
 *   stderr(str)         - 写入标准错误
 */
actor IO {
  new create() => {
    // 初始化 IO
  }

  fun print(s: String) => {
    print(s)
  }

  fun println(s: String) => {
    println(s)
  }

  fun read() => {
    return read_line()
  }

  fun file_open(path: String, mode: String = "r") => {
    return open_file(path, mode)
  }

  fun file_close(f: Any) => {
    close_file(f)
  }

  fun file_read(f: Any) => {
    return read_file(f)
  }

  fun file_write(f: Any, data: String) => {
    write_file(f, data)
  }

  fun stdout(s: String) => {
    stdout(s)
  }

  fun stderr(s: String) => {
    stderr(s)
  }

  fun now() => {
    return current_time()
  }

  fun sleep(ms: Int) => {
    sleep_ms(ms)
  }
}

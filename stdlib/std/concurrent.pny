/**
 * std.concurrent - 并发原语: Mutex, Channel, Future, Actor Group
 *
 * API:
 *   actor Mutex - be lock() / be unlock() / be try_lock() => Bool
 *   actor Channel[T] - be send(value: T) / be receive() => T / be close()
 *   actor Future[T] - be await() => T / be done() => Bool
 *   actor ActorGroup - be add(actor: ActorRef) / be remove(actor: ActorRef) / be count() => I64
 */
actor Mutex {
  be lock() => {}
  be unlock() => {}
  be try_lock() => Bool => {
    return true
  }
}

actor Channel {
  var capacity: I64
  var closed: Bool
  new create(capacity: I64 = 0) => {
    this.capacity = capacity
    this.closed = false
  }
  be send(value: String) => {}
  be receive() => String => {
    return ""
  }
  be close() => {
    this.closed = true
  }
  be is_closed() => Bool => {
    return this.closed
  }
  be len() => I64 => {
    return 0
  }
}

actor Future {
  var done: Bool
  var result: String
  new create() => {
    this.done = false
    this.result = ""
  }
  be resolve(value: String) => {
    this.result = value
    this.done = true
  }
  be await() => String => {
    return this.result
  }
  be is_done() => Bool => {
    return this.done
  }
}

actor ActorGroup {
  var actors: List[ActorRef]
  new create() => {
    this.actors = List()
  }
  be add(actor: ActorRef) => {
    this.actors.append(actor)
  }
  be remove(actor: ActorRef) => {}
  be count() => I64 => {
    return this.actors.length
  }
  be broadcast(msg: String) => {}
}
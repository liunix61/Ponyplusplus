/**
 * std.actor - Actor 基类、spawn、supervise
 *
 * API:
 *   new create()
 *   be spawn(name: String) => ActorRef
 *   be stop()
 *   be supervise(child: ActorRef, strategy: String)
 *   be children() => List[ActorRef]
 */
actor Actor {
  var name: String
  var children: List[Actor]
  new create(name: String = "actor") => {
    this.name = name
    this.children = List()
  }
  be spawn(child_name: String) : Actor => {
    val ref = Actor(child_name)
    this.children.append(ref)
    return ref
  }
  be stop() => {}
  be supervise(child: Actor, strategy: String = "one_for_one") => {
    this.children.append(child)
  }
  be children() : List[Actor] => {
    return this.children
  }
}

/**
 * compiler/codegen.pny - Pony++ 代码生成器（自举用）
 *
 * 用 Pony++ 重写代码生成器，对齐 C 版 codegen.c 行为。
 * 生成: WASM binary / Native C code / AST dump
 *
 * 自举验证: ponyppc --bootstrap 编译本文件，
 *           输出与 C 版 codegen.c 一致。
 */

// 目标类型
val TARGET_NATIVE: Int = 0
val TARGET_WASM: Int = 1
val TARGET_AST: Int = 2
val TARGET_WIT_WORLD: Int = 3

// 生成配置
actor CodegenConfig {
  var target: Int
  var output_path: String
  var optimize: Int
  var emit_ast: Bool
  var emit_ast_dot: Bool
  var wasm32: Bool

  new create() => {
    this.target = TARGET_NATIVE
    this.output_path = ""
    this.optimize = 0
    this.emit_ast = false
    this.emit_ast_dot = false
    this.wasm32 = true
  }
}

// 代码生成器
actor Codegen {
  var cfg: CodegenConfig
  var filename: String
  var output: StringBuilder
  var error: String

  new create(filename: String, cfg: CodegenConfig) => {
    this.filename = filename
    this.cfg = cfg
    this.output = StringBuilder()
    this.error = ""
  }

  // 主入口：从 AST 生成代码
  fun generate(ast: ASTNode) => {
    output = StringBuilder()
    error = ""

    if cfg.emit_ast => {
      output.append(ast.to_string())
      return output.to_string()
    }

    if cfg.emit_ast_dot => {
      return generate_dot(ast)
    }

    if cfg.target == TARGET_NATIVE => {
      return generate_native(ast)
    } else if cfg.target == TARGET_WASM => {
      return generate_wasm(ast)
    } else if cfg.target == TARGET_AST => {
      output.append(ast.to_string())
      return output.to_string()
    }

    return output.to_string()
  }

  // 生成 Native C 代码
  fun generate_native(ast: ASTNode) => {
    output = StringBuilder()
    output.append("// Generated by Pony++ Codegen (Bootstrap)\n")
    output.append("#include <stdio.h>\n")
    output.append("#include <stdlib.h>\n\n")

    // 处理每个顶层节点
    for child in ast.children => {
      generate_native_node(child)
    }

    return output.to_string()
  }

  // 生成 Native 节点
  fun generate_native_node(node: ASTNode) => {
    if node.node_type == NODE_ACTOR || node.node_type == NODE_CLASS => {
      generate_native_type(node)
    }
  }

  // 生成 Native 类型
  fun generate_native_type(node: ASTNode) => {
    val name = node.ident
    output.append("// Actor: " + name + "\n")
    output.append("typedef struct " + name + " {\n")

    for child in node.children => {
      if child.node_type == NODE_VAR || child.node_type == NODE_LET => {
        output.append("  void* " + child.ident + ";\n")
      } else if child.node_type == NODE_BE || child.node_type == NODE_FUN || child.node_type == NODE_NEW => {
        // 方法
      }
    }
    output.append("} " + name + ";\n\n")

    // 方法
    for child in node.children => {
      if child.node_type == NODE_BE || child.node_type == NODE_FUN || child.node_type == NODE_NEW => {
        generate_native_method(name, child)
      }
    }
  }

  // 生成 Native 方法
  fun generate_native_method(type_name: String, node: ASTNode) => {
    val name = node.ident
    val prefix = if node.node_type == NODE_BE then "void"
                 else if node.node_type == NODE_FUN then "void"
                 else if node.node_type == NODE_NEW then "void"
                 else "void"

    output.append(prefix + " " + type_name + "_" + name + "(")
    output.append("void *self")

    // 参数
    for param in node.children => {
      if param.node_type == NODE_IDENT => {
        output.append(", void *")
        output.append(param.ident)
      }
    }
    output.append(") {\n")

    // 方法体
    for child in node.children => {
      if child.node_type == NODE_EMPTY => {
        // body block
        generate_native_body(child)
      }
    }
    output.append("}\n\n")
  }

  // 生成 Native 方法体
  fun generate_native_body(node: ASTNode) => {
    for child in node.children => {
      if child.node_type == NODE_PRINT => {
        output.append("  // print statement\n")
      } else if child.node_type == NODE_RETURN => {
        output.append("  // return\n")
      } else if child.node_type == NODE_IF => {
        output.append("  // if statement\n")
      } else if child.node_type == NODE_WHILE => {
        output.append("  // while loop\n")
      } else if child.node_type == NODE_CALL => {
        output.append("  // call: " + child.ident + "\n")
      }
    }
  }

  // 生成 WASM binary
  fun generate_wasm(ast: ASTNode) => {
    output = StringBuilder()
    // WASM magic number
    output.append("\x00\x61\x73\x6d")  // \0asm
    // version
    output.append("\x01\x00\x00\x00")  // v1

    // Type section
    // Function section
    // Export section

    return output.to_string()
  }

  // 生成 Graphviz DOT
  fun generate_dot(ast: ASTNode) => {
    output = StringBuilder()
    output.append("digraph PonyppAST {\n")
    output.append("  node [shape=box, style=filled];\n\n")

    for child in ast.children => {
      output.append(generate_dot_node(child, "0"))
    }

    output.append("}\n")
    return output.to_string()
  }

  fun generate_dot_node(node: ASTNode, parent_id: String) => {
    val result = StringBuilder()
    val node_id = "n" + parent_id
    result.append("  ")
    result.append(node_id)
    result.append(" [label=\"")
    result.append(node_type_name(node.node_type))
    if node.ident != "" => {
      result.append(":")
      result.append(node.ident)
    }
    result.append("\" @")
    result.append(node.line.to_string)
    result.append(":")
    result.append(node.column.to_string)
    result.append("\"];\n")

    var child_idx = 0
    for child in node.children => {
      val child_id = "n" + parent_id + "_" + child_idx.to_string
      result.append("  ")
      result.append(node_id)
      result.append(" -> ")
      result.append(child_id)
      result.append(";\n")
      result.append(generate_dot_node(child, child_id))
      child_idx = child_idx + 1
    }

    return result.to_string()
  }

  fun node_type_name(type: Int) => {
    if type == NODE_PROGRAM => { return "Program" }
    else if type == NODE_ACTOR => { return "Actor" }
    else if type == NODE_CLASS => { return "Class" }
    else if type == NODE_TRAIT => { return "Trait" }
    else if type == NODE_BE => { return "Be" }
    else if type == NODE_FUN => { return "Fun" }
    else if type == NODE_NEW => { return "New" }
    else if type == NODE_VAR => { return "Var" }
    else if type == NODE_LET => { return "Let" }
    else if type == NODE_IF => { return "If" }
    else if type == NODE_WHILE => { return "While" }
    else if type == NODE_FOR => { return "For" }
    else if type == NODE_RETURN => { return "Return" }
    else if type == NODE_PRINT => { return "Print" }
    else if type == NODE_CALL => { return "Call" }
    else if type == NODE_IDENT => { return "Ident" }
    else if type == NODE_STRING => { return "String" }
    else if type == NODE_INT => { return "Int" }
    else if type == NODE_FLOAT => { return "Float" }
    else if type == NODE_BOOL => { return "Bool" }
    else if type == NODE_SEND => { return "Send" }
    else if type == NODE_MATCH => { return "Match" }
    else if type == NODE_TYPE_PARAM => { return "TypeParam" }
    else if type == NODE_IMPORT => { return "Import" }
    else if type == NODE_WIT_WORLD => { return "World" }
    else => { return "Unknown(" + type.to_string + ")" }
  }
}

actor main {
  var pos: U32
  var count: U32
  var src: String

  new create() {
    pos = 0
    count = 0
    src = "actor main { print(\"hi\") }"
  }

  fun is_space(c: Char) {
    if c == ' ' {
      return true
    } else {
      return false
    }
  }

  fun skip_spaces() {
    while pos < 26 {
      if is_space(src.charAt(pos)) {
        pos = pos + 1
      } else {
        pos = pos + 1
        pos = pos - 1
        break
      }
    }
  }

  fun lex_ident() {
    while pos < 26 {
      if src.charAt(pos) >= 'a' && src.charAt(pos) <= 'z' {
        pos = pos + 1
      } else {
        pos = pos + 1
        pos = pos - 1
        break
      }
    }
    count = count + 1
  }

  fun lex_punct() {
    count = count + 1
    pos = pos + 1
  }

  fun lex() {
    while pos < 26 {
      skip_spaces()
      while pos < 26 {
        if is_space(src.charAt(pos)) {
          pos = pos + 1
        } else {
          pos = pos + 1
          pos = pos - 1
          break
        }
      }
      if pos >= 26 {
        break
      }
      if src.charAt(pos) == '{' || src.charAt(pos) == '}' || src.charAt(pos) == '(' || src.charAt(pos) == ')' {
        lex_punct()
      } else if src.charAt(pos) >= 'a' && src.charAt(pos) <= 'z' {
        lex_ident()
      } else {
        pos = pos + 1
      }
    }
  }

  be run() {
    print("Pony++ Bootstrap: Lexer")
    lex()
    print(count)
    if count >= 3 {
      print("Bootstrap PASS")
    } else {
      print("Bootstrap FAIL")
    }
  }
}